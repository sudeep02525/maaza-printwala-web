# Storefront Backend API Endpoint
# In development:
NEXT_PUBLIC_API_URL=http://localhost:5000
# In production (both with or without /api are normalized):
# NEXT_PUBLIC_API_URL=https://api.maazaprintwala.in

# Public Storefront Canonical Domain
NEXT_PUBLIC_SITE_URL=https://maazaprintwala.in

# Payment Gateway (Razorpay Key ID for client-side checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Analytics & Conversion Pixels (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

